# Copie para .env e preencha. Nunca faça commit do .env.
DATABASE_URL=postgresql+psycopg://harness:harness@localhost:5432/harness
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_PROVIDER=anthropic          # anthropic | fake (testes e desenvolvimento offline)
LLM_FALLBACK=true               # usa FakeLLMClient se o LLM real falhar
TASK_MANAGER=local              # local | asana
ASANA_TOKEN=
ASANA_PROJECT_GID=
APP_TIMEZONE=America/Sao_Paulo

# Postgres do docker compose (precisa bater com DATABASE_URL)
POSTGRES_USER=harness
POSTGRES_PASSWORD=harness
POSTGRES_DB=harness
POSTGRES_PORT=5432

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Pasta das regras de negócio (padrão: config/ na raiz do repositório)
# CONFIG_DIR=
